---
type Props = {
  resortsUrl: string
  searchIndexUrl: string
}

const { resortsUrl, searchIndexUrl } = Astro.props
---

<!-- data-search-index-url 指向建置時產生的靜態搜尋索引。 -->
<form
  class="site-search"
  data-site-search
  data-resorts-url={resortsUrl}
  data-search-index-url={searchIndexUrl}
  role="search"
>
  <div class="site-search__field">
    <input
      id="site-search-input"
      name="q"
      type="search"
      autocomplete="off"
      placeholder="搜尋雪場"
      aria-label="搜尋雪場、區域或縣別"
    />
    <button class="site-search__submit" type="submit" aria-label="送出搜尋">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M5 12h12m-5-5 5 5-5 5" />
      </svg>
    </button>
  </div>
  <div
    class="search-suggestions"
    data-search-suggestions
    role="listbox"
    aria-label="搜尋建議"
    hidden
  ></div>
  <button
    class="site-search__toggle"
    type="button"
    aria-label="開啟搜尋"
    aria-expanded="false"
    aria-controls="site-search-input"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="m21 21-4.3-4.3" />
      <circle cx="11" cy="11" r="7" />
    </svg>
  </button>
</form>

<script>
  import initializeSiteSearch from '../scripts/siteSearch.ts'

  initializeSiteSearch()
</script>
